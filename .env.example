# Copy to .env (git-ignored). No paid keys are needed anywhere in this project.

# --- Local PostgreSQL (docker compose or a native install) ---
POSTGRES_USER=arthasense
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arthasense
POSTGRES_PORT=5432

# Used by services/api, db/migrate.py and pipeline/
ARTHASENSE_DATABASE_URL=postgresql://arthasense:change-me-locally@127.0.0.1:5432/arthasense

# Separate database for integration tests (it gets wiped)
ARTHASENSE_TEST_DATABASE_URL=postgresql://arthasense:change-me-locally@127.0.0.1:5432/arthasense_test

# --- Web (apps/web reads this on the server only) ---
ARTHASENSE_API_URL=http://127.0.0.1:8000
