# Frontend (Next.js) environment. Copy to .env.local for local overrides (git-ignored).
# These are read on the SERVER only; nothing here is sent to the browser.

# URL of the FastAPI backend.
#   local development : http://127.0.0.1:8000   (the default if unset)
#   production (Vercel): https://arthasense-ai.onrender.com
ARTHASENSE_API_URL=http://127.0.0.1:8000

# Public address of this site (used for page metadata). Optional; defaults to the production URL.
# ARTHASENSE_SITE_URL=https://arthasense-ai.vercel.app

# Optional tuning for a backend that may be asleep (free Render instances take up to ~1 minute to wake).
# ARTHASENSE_API_TIMEOUT_MS=20000      # per attempt, 1000-120000
# ARTHASENSE_API_ATTEMPTS=2            # 1-4; retries only network errors and 502/503/504
# ARTHASENSE_API_RETRY_DELAY_MS=2000   # pause between attempts
