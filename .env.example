# Copy to .env (git-ignored). No paid keys are needed anywhere in this project.
# This file contains placeholders only. Never put real passwords here or commit a real .env.

# --- Local PostgreSQL (docker compose or a native install) ---
POSTGRES_USER=arthasense
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arthasense
POSTGRES_PORT=5432

# Used by services/api, db/migrate.py and pipeline/
# Hosted example (Supabase *Session pooler*, IPv4; see docs/DEPLOYMENT.md). Set this on Render as a SECRET,
# never in a file in this repository. A password containing @ / # ? % : must be URL-encoded (%40 %2F %23 ...).
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
ARTHASENSE_DATABASE_URL=postgresql://arthasense:change-me-locally@127.0.0.1:5432/arthasense

# Only for the one-off data copy (python -m db.transfer): the hosted database to copy INTO.
# Set it in your PowerShell session for that command; do not store a real value in any file.
# ARTHASENSE_TARGET_DATABASE_URL=

# Separate database for integration tests (it gets wiped)
ARTHASENSE_TEST_DATABASE_URL=postgresql://arthasense:change-me-locally@127.0.0.1:5432/arthasense_test

# --- API (services/api) ---
# Comma-separated browser origins allowed to call the API (scheme://host[:port], no trailing path, no wildcard).
# Unset = the production frontend plus local development origins.
#   production: ARTHASENSE_CORS_ORIGINS=https://arthasense-ai.vercel.app
# ARTHASENSE_CORS_ORIGINS=https://arthasense-ai.vercel.app,http://localhost:5000,http://127.0.0.1:5000
# ARTHASENSE_API_CONNECT_TIMEOUT_S=8     # database connect timeout for data endpoints

# --- Web (apps/web reads these on the server only; see apps/web/.env.example) ---
ARTHASENSE_API_URL=http://127.0.0.1:8000

# --- Optional: foundation-model forecasters (Chronos-2, TimesFM 2.5) ---
# Leave unset. Setting it to 1 would allow a 0.5-1 GB weight download (also needs PyTorch).
# ARTHASENSE_ALLOW_MODEL_DOWNLOAD=1
