# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Node / Next.js (apps/web has its own .gitignore too) ---
node_modules/
.next/
out/

# --- data: raw downloads stay local, hashed in the DB ---
data/raw/
data/interim/
data/processed/
*.parquet
*.feather

# --- model weights and caches: never commit ---
models/weights/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
.cache/
hf_cache/

# --- verification probe output (commit only the curated report in docs/) ---
reports/verification/*.json
!reports/verification/.gitkeep

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local research exports (regenerate with python -m pipeline.research export)
data/exports/

# Database dumps, logs and coverage output: never commit
*.dump
*.sql.gz
backup*.sql
*.log
.coverage
htmlcov/

# discovery evidence (raw government responses, cached)
data/evidence/

# --- added 2026-11-23 (cleanup): secrets in other naming styles, local copies and generated output ---
*.env
!.env.example
*.pgdump
*.backup
*.bundle
backups/
*.sqlite
*.sqlite3
*.db
test-results/
playwright-report/
*.tsbuildinfo
